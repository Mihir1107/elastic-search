# Copy to .env and change the passwords before any real use.
# `make preflight` will create .env from this file if it is missing.

# --- Elastic stack (consumed by docker-compose.yml) ---
STACK_VERSION=9.5.3
CLUSTER_NAME=ledger
LICENSE=basic
# Superuser password (used by ES and by the Python clients via ELASTIC_PASSWORD)
ELASTIC_PASSWORD=changeme_elastic
KIBANA_PASSWORD=changeme_kibana
# Host port for es01; es02/es03 are published on ES_PORT+1 / ES_PORT+2
ES_PORT=9200
# Per-container memory limit in bytes (2 GiB). Heap is fixed at 1g in compose.
MEM_LIMIT=2147483648

# --- Python client config (pydantic-settings) ---
# Comma-separated. List every published node: the client round-robins and
# retries elsewhere when one dies, which is what makes the chaos run show
# zero failed requests. A single host here fails every request when it is
# the node that gets killed.
ES_HOST=https://localhost:9200,https://localhost:9201,https://localhost:9202
ES_USERNAME=elastic
ES_CA_CERT=./certs/ca.crt
ES_TIMEOUT=30

# --- Index / model config ---
EMAILS_ALIAS=emails
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIMS=384
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- API hardening ---
# Least-privilege ES user for the API; `make api-user` creates it and fills these.
ES_API_USERNAME=
ES_API_PASSWORD=
# When set, every API request needs X-API-Key (the web proxy adds it).
LEDGER_API_KEY=
# Serve /docs and /openapi.json.
EXPOSE_DOCS=false

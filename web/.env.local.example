# Copy to .env.local.
# false -> the UI calls the FastAPI search API through /api/proxy/* (default)
# true  -> the UI runs against an in-browser fixture corpus (no backend needed)
NEXT_PUBLIC_USE_MOCK=false

# Server-side only. Where the FastAPI app is listening.
API_BASE_URL=http://localhost:8000

# Server-side only. Must match LEDGER_API_KEY in the API's .env when that is set.
LEDGER_API_KEY=

# Optional sign-in: "alice:password,bob:password". Tags record who made them.
LEDGER_BASIC_AUTH=
